# ============================================
# Investment Terminal
# Environment Variables
# ============================================

FINNHUB_API_KEY=your_finnhub_api_key_here

ENVIRONMENT=development
LOG_LEVEL=INFO

# Grounded AI Server Runtime
INVESTMENT_TERMINAL_KNOWLEDGE_DATABASE=data/knowledge/knowledge.db
INVESTMENT_TERMINAL_PROVIDER_USAGE_COST_DATABASE=data/knowledge/provider_usage_cost.db
INVESTMENT_TERMINAL_GROUNDED_GENERATION_DATABASE=data/knowledge/grounded_generations.db
INVESTMENT_TERMINAL_OPENAI_MODEL=gpt-5.2
INVESTMENT_TERMINAL_ALLOWED_OPENAI_MODELS=gpt-5.2
INVESTMENT_TERMINAL_PROVIDER_TIMEOUT_SECONDS=30
INVESTMENT_TERMINAL_PROVIDER_MAX_RETRIES=2

# Mandatory provider economic controls.
# Replace pricing values with the current configured provider/model pricing.
INVESTMENT_TERMINAL_PROVIDER_MAX_OUTPUT_TOKENS=2048
INVESTMENT_TERMINAL_PROVIDER_MAX_TOTAL_TOKENS=8192
INVESTMENT_TERMINAL_PROVIDER_MAX_TOTAL_COST=1.00
INVESTMENT_TERMINAL_PROVIDER_BUDGET_CURRENCY=USD
INVESTMENT_TERMINAL_PROVIDER_INPUT_COST_PER_MILLION_TOKENS=replace_with_current_input_price
INVESTMENT_TERMINAL_PROVIDER_OUTPUT_COST_PER_MILLION_TOKENS=replace_with_current_output_price
INVESTMENT_TERMINAL_PROVIDER_PRICING_CURRENCY=USD

# Inbound request-size guardrail.
INVESTMENT_TERMINAL_MAX_REQUEST_BODY_BYTES=65536

# Process-local inbound rate limiting.
# Production CLI currently requires exactly one worker.
INVESTMENT_TERMINAL_RATE_LIMIT_CAPACITY=10
INVESTMENT_TERMINAL_RATE_LIMIT_REFILL_TOKENS_PER_SECOND=1

# OpenAI provider secret
INVESTMENT_TERMINAL_OPENAI_API_KEY_ENV=INVESTMENT_TERMINAL_OPENAI_API_KEY
INVESTMENT_TERMINAL_OPENAI_API_KEY=your_openai_api_key_here

# Inbound server authentication
INVESTMENT_TERMINAL_SERVER_API_KEY_ENV=INVESTMENT_TERMINAL_SERVER_API_KEY
INVESTMENT_TERMINAL_SERVER_API_KEY=replace_with_a_strong_random_secret

# ============================================
# Investment Terminal
# Environment Variables
# ============================================

FINNHUB_API_KEY=your_finnhub_api_key_here

ENVIRONMENT=development
LOG_LEVEL=INFO

# Grounded AI Server Runtime
INVESTMENT_TERMINAL_KNOWLEDGE_DATABASE=data/knowledge/knowledge.db
INVESTMENT_TERMINAL_OPENAI_MODEL=gpt-5.2
INVESTMENT_TERMINAL_ALLOWED_OPENAI_MODELS=gpt-5.2
INVESTMENT_TERMINAL_PROVIDER_TIMEOUT_SECONDS=30
INVESTMENT_TERMINAL_PROVIDER_MAX_RETRIES=2

# Optional request-size guardrail. Default: 65536 bytes.
INVESTMENT_TERMINAL_MAX_REQUEST_BODY_BYTES=65536

# OpenAI provider secret
INVESTMENT_TERMINAL_OPENAI_API_KEY_ENV=INVESTMENT_TERMINAL_OPENAI_API_KEY
INVESTMENT_TERMINAL_OPENAI_API_KEY=your_openai_api_key_here

# Inbound server authentication
INVESTMENT_TERMINAL_SERVER_API_KEY_ENV=INVESTMENT_TERMINAL_SERVER_API_KEY
INVESTMENT_TERMINAL_SERVER_API_KEY=replace_with_a_strong_random_secret
